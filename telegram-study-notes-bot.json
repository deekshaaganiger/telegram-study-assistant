        "options": {}
      },
      "id": "52c45165-9401-44d0-8acc-c2f54a4b4f0d",
      "name": "Prepare Question",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        112
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.question }}",
        "options": {
          "systemMessage": "You are a study-notes assistant answering questions sent from a Telegram chat. For every user question, respond with detailed, well-structured study notes -- never a short conversational reply. Structure your ENTIRE response using exactly these section headers, in this order, and no others: DEFINITION, WHAT IT IS, USE CASES, NOTES. Format USE CASES and NOTES as bulleted lists. Make WHAT IT IS a clear explanatory paragraph (or short paragraphs). You have access to a Tavily Web Search tool. Only call it when the question genuinely needs current information (news, prices, recent events, anything time-sensitive) -- never call it for general knowledge, timeless concepts, or definitions. Never end your response by suggesting follow-up questions or asking the user anything else -- end the response after the NOTES section."
        }
      },
      "id": "da9c9756-3e52-45d4-915a-bd559fe7369b",
      "name": "Study Notes Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        512,
        112
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash",
        "options": {}
      },
      "id": "08a3f6bf-26f3-425b-9fdb-3bc20e4525af",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        448,
        336
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "8ZgMtejO1xyvBnbN",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "contextWindowLength": 10
      },
      "id": "13ddf8be-1811-4f91-915f-8e93f0d480e6",
      "name": "Chat Memory (per Telegram chat)",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        576,
        336
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.tavily.com/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "query": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('query', 'The web search query to look up. Only used for questions needing current information such as news, prices, or recent events.') }}",
          "search_depth": "basic",
          "max_results": 5
        },
        "options": {},
        "optimizeResponse": true,
        "dataField": "results"
      },
      "id": "43a3c279-b0d3-4a5c-ad2c-bdd40526d832",
      "name": "Tavily Web Search",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        704,
        336
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "BNeon1r4lZSo68hO",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const question = $('Prepare Question').item.json.question;\nconst chatId = $('Prepare Question').item.json.chatId;\nconst username = $('Prepare Question').item.json.username;\nconst answer = $input.item.json.output;\nconst now = new Date();\nconst timestamp = now.toISOString();\nconst dateStr = now.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });\nlet clean = String(question).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-+|-+$)/g, '').slice(0, 60);\nif (!clean) clean = 'study-notes';\nconst docTitle = ('Study Notes - ' + question).slice(0, 120);\nconst headerText = 'Topic: ' + question + '\\nDate: ' + dateStr + '\\n\\n';\nreturn [{ json: { question, chatId, username, answer, timestamp, docTitle, fileName: clean + '.pdf', headerText } }];"
      },
      "id": "e193fc02-7593-4ce5-922d-eb9613a4feb2",
      "name": "Prepare Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        112
      ]
    },
    {
